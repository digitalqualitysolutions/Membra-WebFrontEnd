# Where the Membra API lives. Include the /api prefix, no trailing slash —
# every request the frontend makes is API_BASE_URL + a path like /auth/me,
# and the backend mounts everything under /api (its own health check is
# GET /api/health).
API_BASE_URL=https://your-backend-container.functions.fnc.fr-par.scw.cloud/api

# How long to wait for a response in milliseconds (10000 ms = 10 seconds)
API_TIMEOUT_MS=10000